{
  "name": "comp-cli",
  "version": "1.0.0",
  "description": "CLI tool for installing section-based UI components",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "comp-cli": "./dist/bin/cli.js"
  },
  "files": [
    "dist",
    "templates"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "commander": "^11.1.0",
    "chalk": "^4.1.2",
    "ora": "^5.4.1",
    "fs-extra": "^11.2.0",
    "prompts": "^2.4.2"
  },
  "devDependencies": {
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^20.11.0",
    "@types/prompts": "^2.4.9",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "cli",
    "components",
    "installer",
    "react",
    "nextjs",
    "ui"
  ],
  "license": "MIT"
}
